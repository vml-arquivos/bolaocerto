  qrCodeUrl            String?         @map("qr_code_url")
  linhaDigitavel       String?         @map("linha_digitavel")
  codigoBarras         String?         @map("codigo_barras")
  boletoUrl            String?         @map("boleto_url")
  vencimentoEm         DateTime?       @map("vencimento_em")
