{
  "name": "bolaocerto",
  "private": true,
  "version": "0.1.0",
  "description": "Plataforma de cotas de bolões das Loterias CAIXA",
  "packageManager": "pnpm@11.21.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @bolaocerto/api --filter @bolaocerto/worker dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @bolaocerto/api test:e2e",
    "db:migrate": "pnpm --filter @bolaocerto/api prisma:migrate",
    "db:generate": "pnpm --filter @bolaocerto/api prisma:generate"
  }
}
