generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PapelUsuario {
  cotista
  afiliado
  admin
  operacao
}
enum StatusKyc {
  nao_iniciado
  pendente
  aprovado
  reprovado
}
enum TipoOrganizador {
  admin
  afiliado
}
enum ModeloOperacional {
  mandato
  loterica_parceira
}
enum StatusBolao {
  rascunho
  aberto
  fechado
  registrado
  apurado
  cancelado
}
enum TipoAnexo {
  comprovante_aposta
  jogos_registrados
  recibo_cota
  outro
}
enum StatusCota {
  reservada
  paga
  registrada
  apurada
  premiada
  cancelada
  estornada
}
enum MetodoPagamento {
  pix
  cartao
  boleto
  manual
  pix_automatico
}

enum StatusNotaFiscal {
  aguardando
  aguardando_certificado
  emitida
  erro
  cancelada
}
enum StatusPagamento {
  pendente
  confirmado
  falhou
  estornado
}
enum StatusComissao {
  pendente
  paga
  cancelada
}
enum TipoGrupo {
  oficial
  afiliado
}

enum TipoConvite {
  usuario
  afiliado
  operacao
  admin
}

enum StatusConvite {
  ativo
  usado
  revogado
  expirado
}

model Usuario {
  desativadoEm DateTime? @map("desativado_em")
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome                  String        @db.VarChar(150)
  cpf                   String        @unique @db.VarChar(11)
  email                 String        @unique @db.VarChar(180)
  telefone              String?       @db.VarChar(20)
  dataNascimento        DateTime?     @map("data_nascimento") @db.Date
  senhaHash             String        @map("senha_hash")
  papel                 PapelUsuario  @default(cotista)
  statusKyc             StatusKyc     @default(nao_iniciado) @map("status_kyc")
  chavePixRecebimento   String?       @map("chave_pix_recebimento") @db.VarChar(140)
  enderecoCep           String?       @map("endereco_cep") @db.VarChar(8)
  enderecoLogradouro    String?       @map("endereco_logradouro") @db.VarChar(120)
  enderecoNumero        String?       @map("endereco_numero") @db.VarChar(20)
  enderecoComplemento   String?       @map("endereco_complemento") @db.VarChar(80)
  enderecoBairro        String?       @map("endereco_bairro") @db.VarChar(80)
  enderecoCidade        String?       @map("endereco_cidade") @db.VarChar(80)
  enderecoUf            String?       @map("endereco_uf") @db.VarChar(2)
  tokenVersion          Int           @default(0) @map("token_version")
  tentativasLogin       Int           @default(0) @map("tentativas_login")
  bloqueadoAte          DateTime?     @map("bloqueado_ate")
  totpSecret            String?       @map("totp_secret")
  totpAtivo             Boolean       @default(false) @map("totp_ativo")
  googleSub             String?       @unique @map("google_sub") @db.VarChar(64)
  /// Código do link de indicação do cliente (criado na primeira vez que ele abre "Indicar amigos").
  codigoIndicacao       String?       @unique @map("codigo_indicacao") @db.VarChar(12)
  indicadoPorUsuarioId  String?       @map("indicado_por_usuario_id") @db.Uuid
  indicadoPor           Usuario?      @relation("indicacao_cliente", fields: [indicadoPorUsuarioId], references: [id], onDelete: SetNull)
  indicados             Usuario[]     @relation("indicacao_cliente")
  carteiraMovimentos    CarteiraMovimento[]
  totpRecuperacao       String[]      @default([]) @map("totp_recuperacao")
  criadoEm              DateTime      @default(now()) @map("criado_em")
  atualizadoEm          DateTime      @updatedAt @map("atualizado_em")
  kycDocumentos         KycDocumento[]
  lotericasOperadas     LotericaParceira[] @relation("operador_loterica")
  afiliado              Afiliado?
  indicadoPorAfiliadoId String?       @map("indicado_por_afiliado_id") @db.Uuid
  indicadoPorAfiliado   Afiliado?     @relation("usuarios_indicados", fields: [indicadoPorAfiliadoId], references: [id], onDelete: SetNull)
  gruposCriados         Grupo[]       @relation("criador_grupo")
  boloesCriados         Bolao[]       @relation("criador_bolao")
  cotasCompradas        Cota[]        @relation("comprador_cota")
  mandatos              Mandato[]
  aceitesLegais         AceiteLegal[]
  alertasModalidade     AlertaModalidade[]
  notificacoes          Notificacao[]
  pushInscricoes        PushInscricao[]
  auditorias            AuditoriaEvento[]
  documentosRevisados   KycDocumento[] @relation("revisor_kyc")
  boloesEditados        Bolao[]       @relation("editor_bolao")
  afiliadosAprovados    Afiliado[]    @relation("aprovador_afiliado")
  convitesCriados       Convite[]    @relation("criador_convite")
  convitesUsados        Convite[]    @relation("usuario_convite_usado")
  repassesCriados       RepasseLote[] @relation("criador_repasse")
  comissoesPagas        Comissao[]   @relation("pagador_comissao")
  crmPerfil             CrmPerfil?
  crmNotas              CrmNota[]    @relation("crm_nota_usuario")
  crmNotasEscritas      CrmNota[]    @relation("crm_nota_autor")
  crmAfiliadoPerfis     CrmAfiliadoPerfil[]
  exclusaoSolicitadaEm  DateTime?    @map("exclusao_solicitada_em")
  pausaAte              DateTime?    @map("pausa_ate")
  pausaPermanente       Boolean      @default(false) @map("pausa_permanente")
  limiteMensal          Decimal?     @map("limite_mensal") @db.Decimal(10,2)
  limiteMensalPendente  Decimal?     @map("limite_mensal_pendente") @db.Decimal(10,2)
  limiteMensalPendenteEm DateTime?   @map("limite_mensal_pendente_em")
  tokensSenha           TokenSenha[]
  bolaoInteresses       BolaoInteresse[]
  anexosEnviados        Anexo[]          @relation("anexo_enviado_por")
  distribuicoesCriadas  DistribuicaoBolao[] @relation("distribuicao_criador")
  boloesEnviados        BolaoAfiliado[]  @relation("bolao_afiliado_enviado_por")
  cuponsCriados         Cupom[]          @relation("cupom_criador")
  cuponsUsados          CupomUso[]       @relation("cupom_uso_usuario")
  campanhasCashback     CashbackCampanha[] @relation("campanha_criador")
  gruposMembro          GrupoMembro[]

  @@index([desativadoEm, criadoEm])
  @@map("usuarios")
}

model KycDocumento {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId     String      @map("usuario_id") @db.Uuid
  tipoDocumento String      @map("tipo_documento") @db.VarChar(30)
  arquivoUrl    String      @map("arquivo_url")
  status        StatusKyc   @default(pendente)
  revisadoPor   String?     @map("revisado_por") @db.Uuid
  revisadoEm    DateTime?   @map("revisado_em")
  criadoEm      DateTime    @default(now()) @map("criado_em")
  usuario       Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  revisor       Usuario?    @relation("revisor_kyc", fields: [revisadoPor], references: [id])

  @@map("kyc_documentos")
}

model LotericaParceira {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  razaoSocial           String    @map("razao_social") @db.VarChar(180)
  cnpj                  String    @unique @db.VarChar(14)
  codigoCaixa           String?   @map("codigo_caixa") @db.VarChar(30)
  cidade                String    @db.VarChar(120)
  uf                    String    @db.Char(2)
  percentualRepasse     Decimal   @default(0) @map("percentual_repasse") @db.Decimal(5,2)
  statusContrato        String    @default("ativo") @map("status_contrato") @db.VarChar(20)
  usuarioOperacionalId  String?   @map("usuario_operacional_id") @db.Uuid
  criadoEm              DateTime  @default(now()) @map("criado_em")
  usuarioOperacional    Usuario?  @relation("operador_loterica", fields: [usuarioOperacionalId], references: [id])
  boloes                Bolao[]

  @@map("lotericas_parceiras")
}

model ConfigLoteria {
  modalidade              String   @id @db.VarChar(30)
  nomeExibicao            String   @map("nome_exibicao") @db.VarChar(60)
  valorMinimoCota        Decimal  @map("valor_minimo_cota") @db.Decimal(10,2)
  minCotasBolao          Int      @map("min_cotas_bolao")
  maxCotasBolao          Int      @map("max_cotas_bolao")
  taxaAdministracaoTetoPct Decimal @default(35) @map("taxa_administracao_teto_pct") @db.Decimal(5,2)
  horarioCorteLocal      String   @map("horario_corte_local") @db.VarChar(8)
  diasSemanaSorteio      Int[]    @map("dias_semana_sorteio")
  concursos              Concurso[]

  @@map("config_loteria")
}

model Concurso {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  modalidade            String        @db.VarChar(30)
  numeroConcurso        Int           @map("numero_concurso")
  dataSorteio           DateTime      @map("data_sorteio")
  cutoffAt              DateTime      @map("cutoff_at")
  valorEstimadoPremio  Decimal?      @map("valor_estimado_premio") @db.Decimal(14,2)
  acumulado             Boolean       @default(false)
  status                String        @default("aberto") @db.VarChar(20)
  fonteSincronizacao    String?       @map("fonte_sincronizacao") @db.VarChar(20)
  sincronizadoEm        DateTime      @default(now()) @map("sincronizado_em")
  /// Concurso de festa (ex.: mega-da-virada, sao-joao). Nulo nos concursos comuns.
  especial              String?       @db.VarChar(40)
  nomeEspecial          String?       @map("nome_especial") @db.VarChar(80)
  /// Falso enquanto o número oficial não saiu (numeroConcurso guarda um número provisório negativo).
  numeroDefinido        Boolean       @default(true) @map("numero_definido")
  config                ConfigLoteria @relation(fields: [modalidade], references: [modalidade])
  resultado             Resultado?
  boloes                Bolao[]

  @@unique([modalidade, numeroConcurso])
  @@map("concursos")
}

model Resultado {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  concursoId        String   @unique @map("concurso_id") @db.Uuid
  numerosSorteados  Int[]    @map("numeros_sorteados")
  /// Dupla Sena: dezenas do 2º sorteio do concurso (vazio nas demais modalidades).
  numerosSegundoSorteio Int[] @default([]) @map("numeros_segundo_sorteio")
  listaRateioPremio Json     @map("lista_rateio_premio")
  apuradoEm         DateTime @default(now()) @map("apurado_em")
  concurso          Concurso @relation(fields: [concursoId], references: [id], onDelete: Cascade)

  @@map("resultados")
}

model Afiliado {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId             String          @unique @map("usuario_id") @db.Uuid
  codigoAfiliado        String          @unique @map("codigo_afiliado") @db.VarChar(20)
  statusAprovacao       String          @default("pendente") @map("status_aprovacao") @db.VarChar(20)
  comissaoPadraoPct     Decimal         @default(10) @map("comissao_padrao_pct") @db.Decimal(5,2)
  chavePixRepasse       String?         @map("chave_pix_repasse") @db.VarChar(140)
  aprovadoPor           String?         @map("aprovado_por") @db.Uuid
  aprovadoEm            DateTime?       @map("aprovado_em")
  parentAfiliadoId      String?         @map("parent_afiliado_id") @db.Uuid
  criadoEm              DateTime        @default(now()) @map("criado_em")
  usuario               Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  aprovador             Usuario?       @relation("aprovador_afiliado", fields: [aprovadoPor], references: [id])
  parentAfiliado        Afiliado?      @relation("rede_afiliados", fields: [parentAfiliadoId], references: [id], onDelete: SetNull)
  indicados             Afiliado[]     @relation("rede_afiliados")
  grupos               Grupo[]
  convites             Convite[]      @relation("convites_afiliado")
  usuariosIndicados    Usuario[]      @relation("usuarios_indicados")
  cotasReferenciadas   Cota[]
  boloesRecebidos      BolaoAfiliado[]
  distribuicoesAlvo    DistribuicaoBolao[]
  comissoes            Comissao[]

  @@index([parentAfiliadoId])
  @@map("afiliados")
}

model Convite {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo              String        @unique @db.VarChar(40)
  tipo                TipoConvite
  status              StatusConvite @default(ativo)
  criadoPorUsuarioId  String        @map("criado_por_usuario_id") @db.Uuid
  afiliadoOrigemId    String?       @map("afiliado_origem_id") @db.Uuid
  grupoId             String?       @map("grupo_id") @db.Uuid
  usadoPorUsuarioId   String?       @map("usado_por_usuario_id") @db.Uuid
  emailDestino        String?       @map("email_destino") @db.VarChar(180)
  comissaoPct         Decimal?      @map("comissao_pct") @db.Decimal(5,2)
  expiraEm            DateTime      @map("expira_em")
  usadoEm             DateTime?     @map("usado_em")
  criadoEm            DateTime      @default(now()) @map("criado_em")
  criadoPorUsuario    Usuario       @relation("criador_convite", fields: [criadoPorUsuarioId], references: [id])
  afiliadoOrigem      Afiliado?     @relation("convites_afiliado", fields: [afiliadoOrigemId], references: [id], onDelete: SetNull)
  grupo               Grupo?        @relation(fields: [grupoId], references: [id], onDelete: SetNull)
  usadoPorUsuario     Usuario?      @relation("usuario_convite_usado", fields: [usadoPorUsuarioId], references: [id], onDelete: SetNull)

  @@index([status, expiraEm])
  @@index([afiliadoOrigemId])
  @@map("convites")
}

model Grupo {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome          String        @db.VarChar(120)
  slug          String        @unique @db.VarChar(140)
  tipo          TipoGrupo
  afiliadoId    String?       @map("afiliado_id") @db.Uuid
  imagemCapaUrl String?       @map("imagem_capa_url")
  descricao     String?
  criadoPor     String?       @map("criado_por") @db.Uuid
  criadoEm      DateTime      @default(now()) @map("criado_em")
  /// Pessoas a mais que o admin autoriza a contar no grupo (além das que entraram pelo site).
  capacidadeExtra Int         @default(0) @map("capacidade_extra")
  afiliado      Afiliado?     @relation(fields: [afiliadoId], references: [id])
  criador       Usuario?      @relation("criador_grupo", fields: [criadoPor], references: [id])
  boloes        Bolao[]
  boloesOfertados Bolao[]     @relation("oferta_bl_grupo")
  membros       GrupoMembro[]
  convites      Convite[]

  @@map("grupos")
}

model Bolao {
  comprovanteAntesVenda Boolean @default(false) @map("comprovante_antes_venda")
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  concursoId            String              @map("concurso_id") @db.Uuid
  grupoId               String              @map("grupo_id") @db.Uuid
  criadoPor             String              @map("criado_por") @db.Uuid
  tipoOrganizador       TipoOrganizador     @map("tipo_organizador")
  precificacao         Json?               // Immutable financial snapshot for new priced pools
  numerosApostados      Int[]               @map("numeros_apostados")
  totalCotas            Int?                @map("total_cotas")
  cotasIlimitadas       Boolean             @default(false) @map("cotas_ilimitadas")
  cotasVendidas         Int                 @default(0) @map("cotas_vendidas")
  valorCota             Decimal             @map("valor_cota") @db.Decimal(10,2)
  taxaAdministracaoPct  Decimal             @map("taxa_administracao_pct") @db.Decimal(5,2)
  modeloOperacional     ModeloOperacional   @map("modelo_operacional")
  lotericaParceiraId    String?             @map("loterica_parceira_id") @db.Uuid
  status                StatusBolao         @default(aberto)
  comprovanteUrl        String?             @map("comprovante_url")
  registradoEm          DateTime?           @map("registrado_em")
  teveGanhador          Boolean             @default(false) @map("teve_ganhador")
  premioTotal           Decimal?            @map("premio_total") @db.Decimal(16,2)
  apuracao              Json?
  apuradoEm             DateTime?           @map("apurado_em")
  codigoBilhete         String?             @map("codigo_bilhete") @db.VarChar(80)
  premioMinimoLiberacao Decimal?            @map("premio_minimo_liberacao") @db.Decimal(16,2)
  liberadoEm            DateTime?           @map("liberado_em")
  editadoPor            String?             @map("editado_por") @db.Uuid
  editadoEm             DateTime?           @map("editado_em")
  /// Regras de venda definidas pelo administrador (todas opcionais).
  vendaAntecipada       Boolean             @default(false) @map("venda_antecipada")
  vendaInicioEm         DateTime?           @map("venda_inicio_em")
  vendaFimEm            DateTime?           @map("venda_fim_em")
  maxCotasPorPessoa     Int?                @map("max_cotas_por_pessoa")
  regrasVenda           String?             @map("regras_venda") @db.VarChar(1200)
  /// Bolão de afiliado só abre para venda depois da aprovação do admin.
  aprovacaoSolicitadaEm DateTime?           @map("aprovacao_solicitada_em")
  aprovadoEm            DateTime?           @map("aprovado_em")
  aprovadoPor           String?             @map("aprovado_por") @db.Uuid
  /// Intervenção da BL: as cotas que sobraram de um bolão de afiliado passam a ser vendidas num grupo oficial (sem comissão para o afiliado).
  ofertaBlGrupoId       String?             @map("oferta_bl_grupo_id") @db.Uuid
  ofertaBlEm            DateTime?           @map("oferta_bl_em")
  ofertaBlPor           String?             @map("oferta_bl_por") @db.Uuid
  criadoEm              DateTime            @default(now()) @map("criado_em")
  concurso              Concurso            @relation(fields: [concursoId], references: [id])
  grupo                 Grupo               @relation(fields: [grupoId], references: [id])
  ofertaBlGrupo         Grupo?              @relation("oferta_bl_grupo", fields: [ofertaBlGrupoId], references: [id], onDelete: SetNull)
  criador               Usuario            @relation("criador_bolao", fields: [criadoPor], references: [id])
  lotericaParceira      LotericaParceira?  @relation(fields: [lotericaParceiraId], references: [id])
  editor                Usuario?           @relation("editor_bolao", fields: [editadoPor], references: [id])
  cotas                 Cota[]
  distribuicoes         DistribuicaoBolao[]
  afiliadosRecebedores  BolaoAfiliado[]
  jogos                 JogoBolao[]
  interesses            BolaoInteresse[]
  anexos                Anexo[]

  @@index([concursoId, status])
  @@index([criadoPor, status])
  @@index([ofertaBlGrupoId])
  @@map("boloes")
}

model JogoBolao {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bolaoId           String   @map("bolao_id") @db.Uuid
  ordem             Int
  numeros           Int[]
  quantidadeDezenas Int      @map("quantidade_dezenas")
  selecao           Json?
  precoSnapshot     Json? @map("preco_snapshot")
  custo             Decimal  @default(0) @db.Decimal(10,2)
  status            String   @default("ativo") @db.VarChar(20)
  criadoEm          DateTime @default(now()) @map("criado_em")
  bolao             Bolao    @relation(fields: [bolaoId], references: [id], onDelete: Cascade)

  @@unique([bolaoId, ordem])
  @@index([bolaoId, status])
  @@map("jogos_bolao")
}

model Cota {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bolaoId               String          @map("bolao_id") @db.Uuid
  compradorId           String          @map("comprador_id") @db.Uuid
  titularCpf            String          @map("titular_cpf") @db.VarChar(11)
  titularNome           String          @map("titular_nome") @db.VarChar(150)
  quantidade            Int             @default(1)
  valorPago             Decimal?       @map("valor_pago") @db.Decimal(10,2)
  status                StatusCota      @default(reservada)
  reservadaEm          DateTime        @default(now()) @map("reservada_em")
  expiraReservaEm      DateTime?       @map("expira_reserva_em")
  comprovanteIndividualUrl String?      @map("comprovante_individual_url")
  afiliadoReferenciaId  String?         @map("afiliado_referencia_id") @db.Uuid
  faixaPremio           String?         @map("faixa_premio") @db.VarChar(60)
  valorPremio           Decimal?        @map("valor_premio") @db.Decimal(14,2)
  premioNotificadoEm    DateTime?       @map("premio_notificado_em")
  origemVenda           String          @default("online") @map("origem_venda") @db.VarChar(20)
  criadoEm              DateTime        @default(now()) @map("criado_em")
  bolao                 Bolao           @relation(fields: [bolaoId], references: [id])
  comprador             Usuario         @relation("comprador_cota", fields: [compradorId], references: [id])
  afiliadoReferencia    Afiliado?       @relation(fields: [afiliadoReferenciaId], references: [id])
  mandato               Mandato?
  pagamento             Pagamento?
  comissao              Comissao?
  anexos                Anexo[]
  cupomUso              CupomUso?

  @@index([bolaoId, status])
  @@index([compradorId, status])
  @@index([criadoEm])
  @@map("cotas")
}

model Mandato {
  textoSnapshot String? @map("texto_snapshot")
  versao String? @db.VarChar(40)
  pedidoSnapshot Json? @map("pedido_snapshot")
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cotaId      String   @unique @map("cota_id") @db.Uuid
  usuarioId   String   @map("usuario_id") @db.Uuid
  textoHash   String   @map("texto_hash") @db.VarChar(64)
  ipAceite    String   @map("ip_aceite") @db.VarChar(64)
  userAgent   String?  @map("user_agent")
  aceitoEm    DateTime @default(now()) @map("aceito_em")
  cota        Cota     @relation(fields: [cotaId], references: [id])
  usuario     Usuario  @relation(fields: [usuarioId], references: [id])

  @@map("mandatos")
}

model Pagamento {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cotaId               String           @unique @map("cota_id") @db.Uuid
  metodo               MetodoPagamento
  valorBruto           Decimal          @map("valor_bruto") @db.Decimal(10,2)
  valorTaxaAdmin       Decimal          @map("valor_taxa_admin") @db.Decimal(10,2)
  valorComissaoAfiliado Decimal         @default(0) @map("valor_comissao_afiliado") @db.Decimal(10,2)
  valorCustoBilhete    Decimal          @map("valor_custo_bilhete") @db.Decimal(10,2)
  status               StatusPagamento  @default(pendente)
  pspProvedor          String           @map("psp_provedor") @db.VarChar(30)
