/// CRM: etiquetas e acompanhamento comercial de cada apostador.
/// CRM do afiliado: anotações e próximo contato do afiliado sobre os clientes DELE (separado do CRM da administração).
model CrmAfiliadoPerfil {
  afiliadoId       String    @map("afiliado_id") @db.Uuid
  usuarioId        String    @map("usuario_id") @db.Uuid
  etiquetas        String[]  @default([])
  nota             String?
  proximoContatoEm DateTime? @map("proximo_contato_em")
  atualizadoEm     DateTime  @default(now()) @updatedAt @map("atualizado_em")
  usuario          Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([afiliadoId, usuarioId])
  @@index([afiliadoId, proximoContatoEm])
  @@map("crm_afiliado_perfis")
}

model CrmPerfil {
  usuarioId        String    @id @map("usuario_id") @db.Uuid
  etiquetas        String[]  @default([])
  proximoContatoEm DateTime? @map("proximo_contato_em")
  atualizadoEm     DateTime  @default(now()) @updatedAt @map("atualizado_em")
  usuario          Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([proximoContatoEm])
  @@map("crm_perfis")
}

/// CRM: notas internas sobre o apostador (histórico de contato).
model CrmNota {
