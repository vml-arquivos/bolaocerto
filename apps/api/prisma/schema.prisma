  autorId   String   @map("autor_id") @db.Uuid
  texto     String
  criadoEm  DateTime @default(now()) @map("criado_em")
  usuario   Usuario  @relation("crm_nota_usuario", fields: [usuarioId], references: [id], onDelete: Cascade)
  autor     Usuario  @relation("crm_nota_autor", fields: [autorId], references: [id])

  @@index([usuarioId, criadoEm])
  @@map("crm_notas")
}

/// Recuperação de senha: guarda apenas o hash (SHA-256) do token enviado por e-mail.
model TokenSenha {
