  usuarioId String    @map("usuario_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiraEm  DateTime  @map("expira_em")
  usadoEm   DateTime? @map("usado_em")
  criadoEm  DateTime  @default(now()) @map("criado_em")
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, criadoEm])
  @@map("tokens_senha")
}

/// "Avise-me": quem quer ser avisado quando um bolão condicional liberar as cotas.
model BolaoInteresse {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bolaoId     String    @map("bolao_id") @db.Uuid
  usuarioId   String    @map("usuario_id") @db.Uuid
  criadoEm    DateTime  @default(now()) @map("criado_em")
  notificadoEm DateTime? @map("notificado_em")
  bolao       Bolao     @relation(fields: [bolaoId], references: [id], onDelete: Cascade)
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([bolaoId, usuarioId])
  @@index([usuarioId])
  @@map("bolao_interesses")
}

model Anexo {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bolaoId              String    @map("bolao_id") @db.Uuid
  cotaId               String?   @map("cota_id") @db.Uuid
  tipo                 TipoAnexo
  nomeOriginal         String    @map("nome_original") @db.VarChar(200)
  mime                 String    @db.VarChar(80)
  tamanho              Int
  sha256               String    @db.VarChar(64)
  caminho              String    @db.VarChar(300)
  descricao            String?   @db.VarChar(200)
  visivelParticipantes Boolean   @default(true) @map("visivel_participantes")
  enviadoPor           String    @map("enviado_por") @db.Uuid
  criadoEm             DateTime  @default(now()) @map("criado_em")
  removidoEm           DateTime? @map("removido_em")
  removidoPor          String?   @map("removido_por") @db.Uuid
  bolao                Bolao     @relation(fields: [bolaoId], references: [id])
  cota                 Cota?     @relation(fields: [cotaId], references: [id])
  autor                Usuario   @relation("anexo_enviado_por", fields: [enviadoPor], references: [id])

  @@index([bolaoId, removidoEm])
  @@index([cotaId])
  @@index([sha256])
  @@map("anexos")
