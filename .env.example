NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://localhost:3001/api/v1
API_PROXY_URL=http://localhost:3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bolaocerto?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=gere-um-segredo-com-32-caracteres-ou-mais
JWT_REFRESH_SECRET=gere-outro-segredo-com-32-caracteres-ou-mais
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CAIXA_API_BASE_URL=https://servicebus2.caixa.gov.br/portaldeloterias/api
CAIXA_API_TIMEOUT_MS=15000
CAIXA_FALLBACK_BASE_URL=
CAIXA_USER_AGENT=
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=disabled
PAYMENT_TEST_MODE=false
PAYMENT_API_BASE_URL=https://api-sandbox.asaas.com/api/v3
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
MANDATO_TERM_HASH=8ec5ca4780eb0d72a87d7f08379a5b31a373c5b58ba3d3769f3d7dfb05e81ff4
MANDATO_TERM_VERSION=2026-09-01
SHARE_RESERVATION_MINUTES=15
# Prazo (dias) para o cliente pedir o cancelamento de cota paga (Código de Defesa do Consumidor: 7)
CANCELAMENTO_PRAZO_DIAS=7
ADMIN_BOOTSTRAP_EMAIL=admin@bolaolivre.local
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_CPF=
S3_ENDPOINT=
S3_REGION=sa-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Cora (PAYMENT_PROVIDER=cora): boleto com Pix e Pix por QR Code ---
# Credenciais: Cora > Integrações > Integração direta (certificado + chave privada + client id).
# Cole o conteúdo dos arquivos em base64 (ex.: base64 -w0 certificate.pem) para caber em uma variável.
PUBLIC_API_URL=https://bl.buscarr.com.br
CORA_ENV=stage
CORA_CLIENT_ID=
CORA_CERT_BASE64=
CORA_KEY_BASE64=
CORA_MIN_AMOUNT=5
PAYMENT_BOLETO_DUE_DAYS=2
PAYMENT_BOLETO_MIN_HOURS_TO_CUTOFF=96
# PAYMENT_WEBHOOK_SECRET protege o webhook da Cora (use um valor longo e aleatório).

# --- Nota fiscal de serviço (NFS-e) pela API da Cora (beta) ---
# NFSE_MODE: off = desligada | manual = o admin emite pelo painel | auto = emite sozinha quando o participante informa o endereço.
# Defina alíquota e código de serviço COM O SEU CONTADOR antes de ligar. A Cora emite a nota pelo valor total da cobrança.
NFSE_MODE=off
NFSE_ISS_PCT=
NFSE_SERVICE_CODE=
NFSE_CNAE=
NFSE_MUNICIPAL_TAX_CODE=
NFSE_DESCRIPTION=Serviço de intermediação e administração de participação em bolão
NFSE_ISS_WITHHELD=
# Modo auto: só emite para pagamentos confirmados a partir desta data (AAAA-MM-DD). Padrão: últimos 30 dias.
NFSE_AUTO_SINCE=
# Cadastro do emissor (botão "Cadastrar emissor" em Notas fiscais). Regimes: SIMPLES_NACIONAL, SIMPLES_NACIONAL_EXCESSO, REGIME_NORMAL_LUCRO_PRESUMIDO, NORMAL_LUCRO_REAL.
NFSE_MUNICIPAL_REGISTER=
NFSE_STATE_REGISTER=
NFSE_TAX_REGIME=SIMPLES_NACIONAL
NFSE_SPECIAL_TAX_REGIME=NONE
NFSE_RPS_SERIAL=1
NFSE_RPS_LAST_NUMBER=1

# --- Nota fiscal de serviço pela Focus NFe (recomendado: a nota sai só pelo valor da taxa de administração) ---
# NFSE_PROVIDER=focus liga este emissor; sem isso o sistema usa a Cora (que emite pelo valor da cobrança inteira).
# O certificado digital A1 e a empresa são cadastrados no painel da Focus NFe, não aqui. Comece em homologacao (teste) e só depois use producao.
NFSE_PROVIDER=
NFSE_FOCUS_TOKEN=
NFSE_FOCUS_ENV=homologacao
# Opcional: segredo do webhook da Focus (o mesmo valor vai em "Chave de Autorização" na Focus, com o cabeçalho X-Focus-Segredo)
NFSE_FOCUS_WEBHOOK_SECRET=
# CNPJ do prestador (se vazio, usa LEGAL_OPERATOR_CNPJ) e inscrição municipal (NFSE_MUNICIPAL_REGISTER, mais acima). Brasília/DF = 5300108.
NFSE_CNPJ=
NFSE_IBGE=5300108
# Código de tributação nacional do serviço (6 dígitos, ex.: 170901) e o municipal, se a prefeitura pedir.
NFSE_TRIB_NACIONAL=
# Em Brasília, se ficar vazio, usa os 4 primeiros dígitos do código nacional (ex.: 100801 vira 1008).
NFSE_TRIB_MUNICIPAL=
# Opção Simples Nacional: 3 = ME/EPP (padrão), 2 = MEI, 1 = não optante. NFSE_SIMPLES_PCT = percentual aproximado de tributos (informativo).
NFSE_SIMPLES_OPCAO=3
NFSE_SIMPLES_PCT=0
# Reforma tributária (só preencha se a prefeitura exigir): NBS, indicador da operação, CST e classificação do IBS/CBS.
# Se ficar vazio e NFSE_TRIB_NACIONAL for 190101 (venda de produtos de loteria), usa o NBS 109051100.
NFSE_NBS=
NFSE_INDICADOR_OPERACAO=
NFSE_IBS_CBS_CST=
NFSE_IBS_CBS_CLASS=

# --- Recibo, CRM e relatorios (todos opcionais) ---
# Segredo que assina o codigo de verificacao dos recibos. Se vazio, usa JWT_ACCESS_SECRET. Defina um valor proprio e NAO o troque depois (recibos antigos deixam de validar).
RECEIPT_SECRET=
# Niveis do CRM: total investido (R$) em cotas pagas para atingir cada nivel.
CRM_NIVEL_PRATA=1000
CRM_NIVEL_OURO=5000
CRM_NIVEL_DIAMANTE=20000
# Inativo = sem comprar ha N dias | Novo = primeira compra nos ultimos N dias | Recorrente = N ou mais boloes diferentes.
CRM_INATIVO_DIAS=90
CRM_NOVO_DIAS=30
CRM_RECORRENTE_MIN_BOLOES=3

# ── E-mail (opcional). Sem SMTP_HOST o sistema funciona igual; só não envia e-mails.
# Exemplo com a Brevo: SMTP_HOST=smtp-relay.brevo.com, porta 587, SMTP_SECURE=false,
# SMTP_USER = "Login SMTP" (xxxx@smtp-brevo.com) e SMTP_PASS = "Chave SMTP" (Brevo → SMTP e API).
# Também valem os nomes SMTP_PASSWORD (senha), SMTP_FROM_EMAIL + SMTP_FROM_NAME (remetente), SMTP_REPLY_TO e SMTP_REQUIRE_TLS.
# O remetente de MAIL_FROM precisa estar validado na Brevo (domínio com SPF/DKIM verificados).
# Usado em: recuperação de senha e avisos (pagamento confirmado, bolão liberado, cota premiada).
APP_PUBLIC_URL=https://seu-dominio.com.br
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="BL — Bolão Livre <no-reply@seu-dominio.com.br>"

# ── Importação do histórico de sorteios (estatísticas). Roda sozinha no worker.
HISTORY_BACKFILL_DEPTH=400
HISTORY_BACKFILL_BATCH=25
HISTORY_BACKFILL_PAUSE_MS=250

# ── Segurança de contas
# Entrar com Google (opcional). Deixe vazio para manter o botão desligado.
GOOGLE_CLIENT_ID=

# Chave para criptografar o segredo do 2FA no banco. Defina ANTES de alguém ativar o 2FA e NUNCA a altere
# (se mudar, quem usa 2FA fica sem conseguir entrar até um admin redefinir). Gere com: openssl rand -hex 32
TOTP_ENC_KEY=
# Bloqueio de conta por tentativas de login erradas
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# false desativa apenas o bloqueio temporário por tentativas para administradores.
ADMIN_LOGIN_LOCK_ENABLED=true

# ── Alertas operacionais (opcional). URL de webhook de entrada do Slack/Discord/etc.
# Avisa: erros 5xx, aposta paga sem registro perto do sorteio, apuração atrasada, CAIXA fora do ar, bolão premiado.
ALERT_WEBHOOK_URL=
ALERT_ENV_LABEL=PRODUCAO

# Arquivos enviados (comprovantes dos jogos, recibos). Em Docker/Coolify use um volume persistente em /data/uploads.
UPLOAD_DIR=./uploads
UPLOAD_MAX_MB=10

# Avisos no celular (push/PWA). OPCIONAL: se ficar em branco o sistema cria as chaves sozinho e guarda no banco.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contato@seudominio.com.br

# --- Aplicativo Android (opcional, veja docs/android.md) ---
# ANDROID_PACKAGE_NAME=br.com.bolaolivre.app
# ANDROID_SHA256_CERT_FINGERPRINTS=
# ANDROID_APK_URL=
# ANDROID_PLAY_URL=
# ANDROID_ADMIN_PACKAGE_NAME=br.com.bolaolivre.admin
# ANDROID_ADMIN_SHA256_CERT_FINGERPRINTS=
