{
  "name": "bolaocerto",
  "private": true,
  "version": "0.1.0",
  "description": "BL — Bolão Livre | Plataforma web de gerenciamento de bolões",
  "packageManager": "pnpm@11.21.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm db:generate && pnpm -r build",
    "dev": "pnpm --parallel --filter @bolaocerto/api --filter @bolaocerto/web --filter @bolaocerto/worker dev",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @bolaocerto/api test:e2e",
    "db:migrate": "pnpm --filter @bolaocerto/api prisma:migrate",
    "db:generate": "pnpm --filter @bolaocerto/api prisma:generate",
    "db:seed": "pnpm --filter @bolaocerto/api prisma:seed"
  }
}
