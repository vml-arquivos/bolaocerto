/// Append-only price versions; no overlap for a modality/key (migration constraint).
model PrecoLoteria {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  modalidade String @db.VarChar(30)
  chave String @db.VarChar(30)
  valorCentavos Int @map("valor_centavos")
  fonte String
  verificadoEm DateTime @map("verificado_em")
  vigenteDesde DateTime @map("vigente_desde")
  vigenteAte DateTime? @map("vigente_ate")
  @@unique([modalidade, chave, vigenteDesde])
  @@index([modalidade, chave, vigenteAte])
  @@map("precos_loteria")
}

/// Funil de conversão: só contagem por dia e etapa (visitas, bolão visto, cadastro iniciado). Sem dado pessoal.
model ContadorFunil {
  dia   DateTime @db.Date
  nome  String   @db.VarChar(30)
  total Int      @default(0)
  @@id([dia, nome])
  @@map("contadores_funil")
}

/// Textos de Termos, Privacidade e contratos publicados pelo painel (Documentos). O mais recente com ativo=true vale.
model DocumentoPublicado {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipo           String   @db.VarChar(30)
  versao         String   @db.VarChar(40)
  texto          String
  hash           String   @db.VarChar(64)
  ativo          Boolean  @default(true)
  publicadoPorId String?  @map("publicado_por_id") @db.Uuid
  publicadoEm    DateTime @default(now()) @map("publicado_em")
  @@index([tipo, publicadoEm])
  @@map("documentos_publicados")
}

model AceiteLegal {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId String @map("usuario_id") @db.Uuid
  tipo String @db.VarChar(30)
  hash String @db.VarChar(64)
  versao String @db.VarChar(40)
  texto String
  ip String @db.VarChar(64)
  userAgent String? @map("user_agent")
  aceitoEm DateTime @default(now()) @map("aceito_em")
  usuario Usuario @relation(fields: [usuarioId], references: [id])
  @@unique([usuarioId, tipo, hash])
  @@map("aceites_legais")
}

/// Pessoas que entraram em um grupo (a capacidade do grupo limita as cotas dos bolões do afiliado).
model GrupoMembro {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  grupoId   String   @map("grupo_id") @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  criadoEm  DateTime @default(now()) @map("criado_em")
  grupo     Grupo    @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([grupoId, usuarioId])
  @@index([usuarioId])
  @@map("grupo_membros")
}

/// Aparelho/navegador que aceitou receber avisos (Web Push / PWA).
model PushInscricao {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId  String    @map("usuario_id") @db.Uuid
  endpoint   String    @unique
  p256dh     String
  auth       String
  agente     String?   @db.VarChar(200)
  falhas     Int       @default(0)
  criadoEm   DateTime  @default(now()) @map("criado_em")
  ultimoEnvioEm DateTime? @map("ultimo_envio_em")
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("push_inscricoes")
}

/// Mensagem enviada pela equipe a um grupo de clientes.
model Comunicado {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titulo     String   @db.VarChar(120)
  mensagem   String   @db.VarChar(600)
  link       String?  @db.VarChar(200)
  publico    String   @db.VarChar(30)
  bolaoId    String?  @map("bolao_id") @db.Uuid
  grupoId    String?  @map("grupo_id") @db.Uuid
  enviarEmail Boolean @default(false) @map("enviar_email")
  totalDestinatarios Int @map("total_destinatarios")
  criadoPor  String   @map("criado_por") @db.Uuid
  criadoEm   DateTime @default(now()) @map("criado_em")

  @@index([criadoEm])
  @@map("comunicados")
}

/// Pequenas configurações geradas pelo sistema (ex.: chaves VAPID do push).
model ConfiguracaoSistema {
  chave        String   @id @db.VarChar(60)
  valor        String
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em")

  @@map("configuracoes_sistema")
}

/// Banco de números: jogos gerados ou digitados que ficam guardados para reaproveitar nos bolões e cruzar com os resultados.
model BancoNumeros {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  modalidade        String    @db.VarChar(20)
  numeros           Int[]
  quantidadeDezenas Int       @map("quantidade_dezenas")
  /// modalidade + dezenas em ordem crescente: impede guardar o mesmo jogo duas vezes.
  chave             String    @unique @db.VarChar(400)
  origem            String    @db.VarChar(20)
  estrategia        String?   @db.VarChar(30)
  rotulo            String?   @db.VarChar(80)
  usos              Int       @default(0)
  ultimoUsoEm       DateTime? @map("ultimo_uso_em")
  criadoPor         String?   @map("criado_por") @db.Uuid
  criadoEm          DateTime  @default(now()) @map("criado_em")

  @@index([modalidade, criadoEm])
  @@map("banco_numeros")
}

/// "Avise-me quando abrir bolão de [jogo]": a pessoa escolhe as modalidades e recebe um aviso quando um bolão oficial for publicado.
model AlertaModalidade {
  usuarioId  String   @map("usuario_id") @db.Uuid
  modalidade String   @db.VarChar(30)
  criadoEm   DateTime @default(now()) @map("criado_em")
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@id([usuarioId, modalidade])
  @@index([modalidade])
  @@map("alertas_modalidade")
}

/// Carteira (crédito BL): livro-razão com valores em centavos, positivo = crédito, negativo = uso. O saldo é a soma.
/// Crédito de cashback/reembolso só vale para comprar cotas aqui; não é conta de pagamento nem pode ser sacado.
model CarteiraMovimento {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId    String   @map("usuario_id") @db.Uuid
  tipo         String   @db.VarChar(30)
  valorCentavos Int     @map("valor_centavos")
  descricao    String   @db.VarChar(200)
  /// Impede lançar duas vezes a mesma coisa (ex.: "cashback:<pagamento>").
  chave        String?  @unique @db.VarChar(80)
  criadoPor    String?  @map("criado_por") @db.Uuid
  criadoEm     DateTime @default(now()) @map("criado_em")
  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, criadoEm])
  @@map("carteira_movimentos")
}

/// Link de distribuição: a equipe envia o bolão para afiliados venderem (um link pode ter vários afiliados).
model DistribuicaoBolao {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bolaoId       String    @map("bolao_id") @db.Uuid
  codigo        String    @unique @db.VarChar(40)
  criadoPor     String    @map("criado_por") @db.Uuid
  afiliadoAlvoId String?  @map("afiliado_alvo_id") @db.Uuid
  revogadoEm    DateTime? @map("revogado_em")
  criadoEm      DateTime  @default(now()) @map("criado_em")
  bolao         Bolao     @relation(fields: [bolaoId], references: [id], onDelete: Cascade)
  criador       Usuario   @relation("distribuicao_criador", fields: [criadoPor], references: [id])
  afiliadoAlvo  Afiliado? @relation(fields: [afiliadoAlvoId], references: [id], onDelete: SetNull)
  recebedores   BolaoAfiliado[]

  @@index([bolaoId])
  @@map("bolao_distribuicoes")
}

/// Afiliado que recebeu o bolão e pode vender (aparece no painel dele). As vendas dele são as cotas com o código dele.
model BolaoAfiliado {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bolaoId        String    @map("bolao_id") @db.Uuid
  afiliadoId     String    @map("afiliado_id") @db.Uuid
  distribuicaoId String?   @map("distribuicao_id") @db.Uuid
  enviadoPor     String    @map("enviado_por") @db.Uuid
  aceitoEm       DateTime  @default(now()) @map("aceito_em")
  removidoEm     DateTime? @map("removido_em")
  removidoPor    String?   @map("removido_por") @db.Uuid
  bolao          Bolao     @relation(fields: [bolaoId], references: [id], onDelete: Cascade)
  afiliado       Afiliado  @relation(fields: [afiliadoId], references: [id], onDelete: Cascade)
  distribuicao   DistribuicaoBolao? @relation(fields: [distribuicaoId], references: [id], onDelete: SetNull)
  remetente      Usuario   @relation("bolao_afiliado_enviado_por", fields: [enviadoPor], references: [id])

  @@unique([bolaoId, afiliadoId])
  @@index([afiliadoId])
  @@map("bolao_afiliados")
}

/// Cupom de desconto criado pelo administrador. Vale só para os grupos e clientes escolhidos (nunca para todos).
/// O desconto sai da taxa de administração: o dinheiro do bolão (custo dos jogos) nunca é reduzido.
model Cupom {
  id                     String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  codigo                 String     @unique @db.VarChar(40)
  descricao              String?    @db.VarChar(200)
  /// "percentual" (valor = % do total) ou "valor" (valor = reais por compra).
  tipo                   String     @db.VarChar(12)
  valor                  Decimal    @db.Decimal(10, 2)
  descontoMaximoCentavos Int?       @map("desconto_maximo_centavos")
  valorMinimoCentavos    Int?       @map("valor_minimo_centavos")
  /// Aplicado sozinho na compra de quem tem direito; sem isso a pessoa digita o código.
  automatico             Boolean    @default(false)
  ativo                  Boolean    @default(true)
  inicioEm               DateTime?  @map("inicio_em")
  fimEm                  DateTime?  @map("fim_em")
  limiteTotal            Int?       @map("limite_total")
  limitePorCliente       Int?       @map("limite_por_cliente")
  grupoIds               String[]   @default([]) @map("grupo_ids") @db.Uuid
  usuarioIds             String[]   @default([]) @map("usuario_ids") @db.Uuid
  criadoPor              String     @map("criado_por") @db.Uuid
  criadoEm               DateTime   @default(now()) @map("criado_em")
  atualizadoEm           DateTime   @default(now()) @updatedAt @map("atualizado_em")
  criador                Usuario    @relation("cupom_criador", fields: [criadoPor], references: [id])
  usos                   CupomUso[]

  @@map("cupons")
}

/// Uso de um cupom numa cota (uma cota usa no máximo um cupom). Conta como uso enquanto a cota estiver reservada (no prazo) ou paga.
model CupomUso {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cupomId          String   @map("cupom_id") @db.Uuid
  cotaId           String   @unique @map("cota_id") @db.Uuid
  usuarioId        String   @map("usuario_id") @db.Uuid
  descontoCentavos Int      @map("desconto_centavos")
  /// Parte do desconto que passou da taxa de administração (o BL banca).
  subsidioCentavos Int      @default(0) @map("subsidio_centavos")
  criadoEm         DateTime @default(now()) @map("criado_em")
  cupom            Cupom    @relation(fields: [cupomId], references: [id])
  cota             Cota     @relation(fields: [cotaId], references: [id], onDelete: Cascade)
  usuario          Usuario  @relation("cupom_uso_usuario", fields: [usuarioId], references: [id])

  @@index([cupomId])
  @@index([usuarioId])
  @@map("cupom_usos")
}

/// Campanha de cashback: depois que o pagamento é confirmado, quem tem direito recebe crédito na carteira.
model CashbackCampanha {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome                    String   @db.VarChar(120)
  percentual              Decimal  @db.Decimal(5, 2)
  valorMinimoCentavos     Int?     @map("valor_minimo_centavos")
  maximoPorCompraCentavos Int?     @map("maximo_por_compra_centavos")
  orcamentoCentavos       Int?     @map("orcamento_centavos")
  /// Nível do cliente: já gastou pelo menos isto (centavos) e/ou já pagou pelo menos esta quantidade de compras.
  gastoMinimoCentavos     Int?     @map("gasto_minimo_centavos")
  comprasMinimas          Int?     @map("compras_minimas")
  ativa                   Boolean  @default(false)
  inicioEm                DateTime? @map("inicio_em")
  fimEm                   DateTime? @map("fim_em")
  grupoIds                String[] @default([]) @map("grupo_ids") @db.Uuid
  usuarioIds              String[] @default([]) @map("usuario_ids") @db.Uuid
  criadoPor               String   @map("criado_por") @db.Uuid
  criadoEm                DateTime @default(now()) @map("criado_em")
  atualizadoEm            DateTime @default(now()) @updatedAt @map("atualizado_em")
  criador                 Usuario  @relation("campanha_criador", fields: [criadoPor], references: [id])

  @@map("cashback_campanhas")
}
